#!/usr/bin/env bash
# Plugin to show iTerm2 authentication credentials being passed to plugins
# This demonstrates that ITERM2_COOKIE and ITERM2_KEY are available

session_id="$1"

# Check if credentials are available
if [ -n "$ITERM2_COOKIE" ]; then
    # Show just the first 8 chars of cookie for security
    cookie_preview="${ITERM2_COOKIE:0:8}..."
    echo "🔑 $cookie_preview"
else
    echo "❌ no-auth"
fi
