#!/usr/bin/env bash
# Plugin to show a hash of the cookie - demonstrates same cookie across all plugins
# This verifies that all plugins receive the same authentication credentials

session_id="$1"

if [ -n "$ITERM2_COOKIE" ]; then
    # Create a short hash of the cookie to verify it's the same across plugins
    hash=$(echo -n "$ITERM2_COOKIE" | md5 | cut -c1-6)
    echo "md5:$hash"
else
    echo "none"
fi
